---
import { site } from '@config/site';

interface Props {
  active?: string;
}

const { active = 'Matches' } = Astro.props;

const navLinks = site.nav.filter((item) => {
  if (item.label === 'Scoreboard' && !site.features?.leaderboard) {
    return false;
  }
  return true;
});
---

<nav
  class="fixed top-0 w-full z-50 border-b border-outline-variant/15 bg-background/70 backdrop-blur-xl transition-all duration-300"
>
  <div class="flex justify-between items-center px-6 md:px-8 py-4 max-w-7xl mx-auto">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/gdg-logo-new.svg" alt="GDG Indore" class="h-20"/>
    </a>
    <div class="hidden md:flex items-center gap-8 font-headline font-medium text-sm tracking-tight" data-nav-links>
      {
        navLinks.map((item) => {
          const isActive = item.label === active;
          return (
            <a
              href={item.href}
              data-nav-label={item.label}
              class={
                isActive
                  ? 'text-primary border-b-2 border-primary-fixed pb-1'
                  : 'text-on-surface/60 hover:text-primary transition-colors'
              }
            >
              {item.label}
            </a>
          );
        })
      }
      </div>
    <div class="flex items-center gap-4">
      <!-- RSVP Button -->
      <a
        href={site.cta.href}
        class="bg-primary-container text-on-primary-container font-headline font-bold px-6 py-2 rounded-full neon-glow transition-all active:scale-95 text-sm"
      >
        {site.cta.label}
      </a>
      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center p-2 text-on-surface/80 hover:text-primary transition-colors focus:outline-none rounded-full bg-surface-container-low border border-outline-variant/20 ml-2"
        aria-label="Toggle Menu"
      >
        <span class="material-symbols-outlined text-[24px]" id="menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div 
    id="mobile-menu" 
    class="absolute top-[100%] left-0 w-full bg-background/95 backdrop-blur-xl border-b border-outline-variant/15 flex flex-col items-center py-8 gap-6 font-headline font-medium text-base tracking-tight transition-all duration-300 transform -translate-y-4 opacity-0 pointer-events-none md:hidden z-40"
  >
    {
      navLinks.map((item) => {
        const isActive = item.label === active;
        return (
          <a
            href={item.href}
            data-mobile-nav-label={item.label}
            class={
              isActive
                ? 'text-primary border-b-2 border-primary-fixed pb-1 px-4'
                : 'text-on-surface/70 hover:text-primary transition-colors px-4'
            }
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  const ACTIVE = 'text-primary border-b-2 border-primary-fixed pb-1';
  const INACTIVE = 'text-on-surface/60 hover:text-primary transition-colors';

  // Mobile Menu Logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  
  if (mobileMenuBtn && mobileMenu && menuIcon) {
    let isOpen = false;
    
    mobileMenuBtn.addEventListener('click', () => {
      isOpen = !isOpen;
      if (isOpen) {
        mobileMenu.classList.remove('-translate-y-4', 'opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        menuIcon.textContent = 'close';
      } else {
        mobileMenu.classList.add('-translate-y-4', 'opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        menuIcon.textContent = 'menu';
      }
    });

    // Close menu when a link is clicked
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        isOpen = false;
        mobileMenu.classList.add('-translate-y-4', 'opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        menuIcon.textContent = 'menu';
      });
    });
  }

  // Only run scroll-spy on the landing page (where sections exist)
  const sections = document.querySelectorAll<HTMLElement>('#playbook, #partners');
  if (sections.length > 0) {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-links] a[data-nav-label]');

    const setActive = (label: string) => {
      links.forEach((a) => {
        a.className = a.getAttribute('data-nav-label') === label ? ACTIVE : INACTIVE;
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            const label = id === 'playbook' ? 'Playbook' : id === 'partners' ? 'Partners' : null;
            if (label) setActive(label);
          }
        }
        // If none of the anchor sections are visible, default to Matches
        const anyVisible = [...sections].some((s) => {
          const r = s.getBoundingClientRect();
          return r.top < window.innerHeight && r.bottom > 0;
        });
        if (!anyVisible) setActive('Matches');
      },
      { threshold: 0.3 }
    );

    sections.forEach((s) => observer.observe(s));
  }
</script>
